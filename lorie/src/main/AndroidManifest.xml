<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
        Pocket Linux Display change: the receivers below are the only way a client can hand the
        X server's Binder to this app. Upstream leaves them open to every app on the device. Here
        a sender must hold CONNECT, which is a normal permission: an app (the Pocket Linux app)
        opts in by declaring <uses-permission> for it. The X server process spawned from the proot
        guest runs under the Pocket Linux app's uid, so it holds the permission automatically.
        ${plReceiverPermission} is filled in by lorie-app/build.gradle (see NOTICE.md).
    -->
    <permission
        android:name="${applicationId}.permission.CONNECT"
        android:description="@string/lorie_permission_connect_desc"
        android:label="@string/lorie_permission_connect_label"
        android:protectionLevel="normal" />

    <application
        android:name=".LorieApp"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules,GoogleAppIndexingWarning">
        <activity
            android:name=".MainActivity"
            android:taskAffinity=".MainActivity"
            android:icon="@mipmap/lorie_ic_launcher"
            android:roundIcon="@mipmap/lorie_ic_launcher_round"
            android:label="@string/lorie_app_name"
            android:theme="@style/LorieAppTheme"
            android:launchMode="singleInstance"
            android:supportsPictureInPicture="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.SECONDARY_HOME" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/lorie_shortcuts" />
        </activity>
        <activity
            android:name=".MainActivity$MainActivityTagged"
            android:taskAffinity=""
            android:theme="@style/LorieAppTheme"
            android:documentLaunchMode="intoExisting"
            android:supportsPictureInPicture="true"
            android:autoRemoveFromRecents="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="false" />
        <activity
            android:theme="@style/Theme.AppCompat.DayNight"
            android:excludeFromRecents="true"
            android:name=".LoriePreferences"
            android:taskAffinity=".LoriePreferences"
            android:supportsPictureInPicture="false"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
	    <meta-data android:name="android.allow_multiple_resumed_activities" android:value="true" />

        <service android:name=".utils.KeyInterceptor"
            android:exported="true"
            android:label="Termux:X11 KeyInterceptor"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver android:name=".LoriePreferences$Receiver" android:exported="true" android:permission="${plReceiverPermission}" tools:ignore="ExportedReceiver" android:enabled="true">
            <intent-filter>
                <action android:name="app.pocketlinux.x11.CHANGE_PREFERENCE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".LorieApp$Receiver" android:exported="true" android:permission="${plReceiverPermission}" tools:ignore="ExportedReceiver" android:enabled="true">
            <intent-filter>
                <action android:name="app.pocketlinux.x11.CmdEntryPoint.ACTION_START" />
                <action android:name="app.pocketlinux.x11.ACTION_STOP" />
                <action android:name="app.pocketlinux.x11.ACTION_PREFERENCES_CHANGED" />
                <action android:name="app.pocketlinux.x11.ACTION_CUSTOM" />
            </intent-filter>
        </receiver>
    </application>
    <queries>
        <package android:name="app.pocketlinux" />
    </queries>
</manifest>
